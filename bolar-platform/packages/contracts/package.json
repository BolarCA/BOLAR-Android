{
  "name": "@bolar/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src && redocly lint openapi.yaml",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bolar/shared": "workspace:*",
    "zod": "^4.6.6",
    "@asteasolutions/zod-to-openapi": "^9.1.0"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.0"
  }
}
