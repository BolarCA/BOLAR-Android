# ---- BOLAR local environment (synthetic values only; never commit real secrets) ----
NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Auth (local dev only; rotate in staging/prod via secret manager)
AUTH_PROVIDER=local
AUTH_JWT_SECRET=local_dev_only_change_me_min_32_chars_long_000
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=1209600

# Data stores
DATABASE_URL=postgresql://bolar:local_only@localhost:5432/bolar?schema=public
REDIS_URL=redis://localhost:6379

# Object storage (MinIO locally; S3 in staging). STORAGE_DRIVER=local writes under .storage/
STORAGE_DRIVER=local
STORAGE_BUCKET=bolar-local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Email / SMS (Mailhog locally; providers in mock mode until sandbox credentials exist)
EMAIL_DRIVER=mailhog
SMTP_HOST=localhost
SMTP_PORT=1025
SMS_DRIVER=mock

# Integration adapters: mock | sandbox | production
STRIPE_MODE=mock
PLAID_MODE=mock
SENDGRID_MODE=mock
TWILIO_MODE=mock
DOCUSIGN_MODE=mock
TRANSUNION_MODE=mock
IDME_MODE=mock

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
